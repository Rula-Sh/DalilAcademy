{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=DalilAcademyDB;Username=postgres"
  },
  "Jwt": {
    "Issuer": "DalilAcademyAPI",
    "Audience": "DalilAcademyClients", // name it however you like
    "ExpiresInHours": 8
  },
  "ExchangeRate": {
    "BaseUrl": "https://v6.exchangerate-api.com/v6/" // the base URL (added here so that i dont keep writing it in the code)
  },
  "PayPal": {
    "BaseUrl": "https://api-m.sandbox.paypal.com",
    "ReturnUrl": "https://localhost:7020/index.html",
    "ExpiresInHours": 3,
    "JODToUSDRate": "1.41"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information", // helps us see every SQL query sent from the EF Core shows up on console
      "System.Net.Http.HttpClient": "Warning" // keep URLs (and the key) out of the console
    }
  },
  "AllowedHosts": "*"
}
